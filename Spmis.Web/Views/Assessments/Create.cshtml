@model Spmis.Web.Models.ClassRecord.AssessmentCreateViewModel
@{ ViewData["Title"] = "Add assessment"; }

<h2>Add assessment</h2>
<p class="text-muted">@Model.Header</p>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="ClassOfferingId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="PeriodId" class="form-label"></label>
        <select asp-for="PeriodId" asp-items="Model.Periods" class="form-select">
            <option value="">— choose —</option>
        </select>
        <span asp-validation-for="PeriodId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ComponentId" class="form-label"></label>
        <select asp-for="ComponentId" asp-items="Model.Components" class="form-select">
            <option value="">— choose —</option>
        </select>
        <span asp-validation-for="ComponentId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" maxlength="150" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MaxScore" class="form-label"></label>
        <input asp-for="MaxScore" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="MaxScore" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" class="form-control" type="datetime-local" />
        <span asp-validation-for="DueDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PassingPercent" class="form-label"></label>
        <input asp-for="PassingPercent" class="form-control" type="number" step="0.01" min="0" max="100" />
        <span asp-validation-for="PassingPercent" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsRequired" class="form-check-input" />
        <label asp-for="IsRequired" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-id="@Model.ClassOfferingId">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }