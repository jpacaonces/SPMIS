@using Spmis.Web.Data.Auth
@model Spmis.Web.Models.Admin.AuditLogListViewModel
@{
    ViewData["Title"] = "Audit log";
    var from = Model.DateFrom?.ToString("yyyy-MM-dd");
    var to = Model.DateTo?.ToString("yyyy-MM-dd");
}

<h1 class="h3 mb-3">Audit log</h1>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-2">
        <label class="form-label small mb-0" for="dateFrom">From</label>
        <input type="date" id="dateFrom" name="dateFrom" value="@from" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-0" for="dateTo">To</label>
        <input type="date" id="dateTo" name="dateTo" value="@to" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-0" for="actionType">Action</label>
        <select id="actionType" name="actionType" class="form-select">
            <option value="">All actions</option>
            @foreach (var a in Model.ActionTypes)
            {
                <option value="@a" selected="@(Model.ActionType == a)">@a</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-0" for="role">Role</label>
        <select id="role" name="role" class="form-select">
            <option value="">All roles</option>
            @foreach (var r in RoleNames.All)
            {
                <option value="@r" selected="@(Model.Role == r)">@r</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-0" for="search">Search</label>
        <input type="text" id="search" name="search" value="@Model.Search" class="form-control"
               placeholder="Person, record id or reason" />
    </div>
    <div class="col-md-1 d-grid align-items-end">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

<p class="text-muted">@Model.TotalCount entr(ies). Page @Model.Page of @Model.TotalPages. Newest first.</p>

<div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>When</th>
                <th>Who</th>
                <th>Role</th>
                <th>Action</th>
                <th>Record</th>
                <th>Reason</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Items)
            {
                <tr>
                    <td class="text-nowrap">@l.OccurredAt?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@l.UserLabel</td>
                    <td>@l.Role</td>
                    <td>@l.ActionType</td>
                    <td>@l.EntityType <span class="text-muted small">@l.EntityId</span></td>
                    <td>@l.Reason</td>
                    <td>
                        @if (!string.IsNullOrEmpty(l.OldValues) || !string.IsNullOrEmpty(l.NewValues))
                        {
                            <details>
                                <summary>View</summary>
                                @if (!string.IsNullOrEmpty(l.OldValues))
                                {
                                    <div class="small"><strong>Before:</strong> <code>@l.OldValues</code></div>
                                }
                                @if (!string.IsNullOrEmpty(l.NewValues))
                                {
                                    <div class="small"><strong>After:</strong> <code>@l.NewValues</code></div>
                                }
                            </details>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted">No entries match.</td></tr>
            }
        </tbody>
    </table>
</div>

<nav class="d-flex gap-2">
    @if (Model.HasPrevious)
    {
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index"
           asp-route-dateFrom="@from" asp-route-dateTo="@to"
           asp-route-actionType="@Model.ActionType" asp-route-role="@Model.Role"
           asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">Previous</a>
    }
    @if (Model.HasNext)
    {
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index"
           asp-route-dateFrom="@from" asp-route-dateTo="@to"
           asp-route-actionType="@Model.ActionType" asp-route-role="@Model.Role"
           asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Next</a>
    }
</nav>
