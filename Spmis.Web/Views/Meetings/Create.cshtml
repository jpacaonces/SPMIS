@model Spmis.Web.Models.ClassRecord.MeetingCreateViewModel
@{
    ViewData["Title"] = "Add meeting";
}

<h2>Add meeting</h2>
<p class="text-muted">@Model.Header · @Model.AttendanceMode attendance</p>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="ClassOfferingId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="MeetingDate" class="form-label"></label>
        <input asp-for="MeetingDate" type="date" class="form-control" />
        <span asp-validation-for="MeetingDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Topic" class="form-label"></label>
        <input asp-for="Topic" class="form-control" maxlength="150" />
        <span asp-validation-for="Topic" class="text-danger"></span>
    </div>

    @if (Model.AttendanceMode == "ActivityBased")
    {
        <div class="mb-3">
            <label asp-for="LinkedAssessmentId" class="form-label"></label>
            <select asp-for="LinkedAssessmentId" asp-items="Model.Assessments" class="form-select">
                <option value="">— choose —</option>
            </select>
            <span asp-validation-for="LinkedAssessmentId" class="text-danger"></span>
        </div>
    }

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-id="@Model.ClassOfferingId">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}