@model Spmis.Web.Models.ClassRecord.ScoreEntryViewModel
@{ ViewData["Title"] = "Enter scores"; }

<h2>Enter scores</h2>
<p class="text-muted">
    @Model.Header · @Model.PeriodName · @Model.ComponentName ·
    <strong>@Model.Title</strong> · max @Model.MaxScore.ToString("0.##")
    @if (Model.DueDate is not null) { <span> · due @Model.DueDate.Value.ToString("yyyy-MM-dd HH:mm")</span> }
</p>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<p class="small text-muted">
    Pending = nothing yet. Submitted = handed in (leave the score blank if not graded yet).
    Missing, Excused and Violation clear the score. Changing a row that already has a recorded
    status asks for a reason.
</p>

<form id="scoreForm" asp-action="Entry" method="post">
    <input type="hidden" name="AssessmentId" value="@Model.AssessmentId" />

    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Student no.</th><th>Name</th><th>Status</th><th>Score</th><th>Submitted at</th><th>Similarity</th></tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Rows.Count; i++)
        {
            var r = Model.Rows[i];
            var recorded = r.Status != "Pending";
            <tr data-recorded="@(recorded ? "true" : "false")"
                data-orig="@r.Status|@r.RawScore|@r.SubmittedAt?.ToString("yyyy-MM-ddTHH:mm")">
                <td>@r.StudentNo</td>
                <td>@r.StudentName</td>
                <td>
                    <input type="hidden" name="Rows[@i].EnrollmentId" value="@r.EnrollmentId" />
                    <input type="hidden" name="Rows[@i].ScoreId" value="@r.ScoreId" />
                    <input type="hidden" name="Rows[@i].RowVersionTicks" value="@r.RowVersionTicks" />
                    <select name="Rows[@i].Status" class="form-select form-select-sm">
                        @foreach (var s in new[] { "Pending", "Submitted", "Missing", "Excused", "Violation" })
                        {
                            <option value="@s" selected="@(s == r.Status)">@s</option>
                        }
                    </select>
                </td>
                <td>
                    <input name="Rows[@i].RawScore" type="number" step="0.01" min="0" max="@Model.MaxScore"
                           class="form-control form-control-sm" value="@r.RawScore" />
                </td>
                <td>
                    <input name="Rows[@i].SubmittedAt" type="datetime-local"
                           class="form-control form-control-sm"
                           value="@r.SubmittedAt?.ToString("yyyy-MM-ddTHH:mm")" />
                </td>
                <td>
                    @if (r.ScoreId != 0 && r.Status == "Submitted")
                    {
                        <a asp-action="Similarity" asp-route-assessmentId="@Model.AssessmentId"
                           asp-route-enrollmentId="@r.EnrollmentId">Check</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    <button type="button" id="saveBtn" class="btn btn-primary">Save scores</button>
    <a class="btn btn-outline-secondary" asp-controller="Assessments" asp-action="Index"
       asp-route-id="@Model.ClassOfferingId">Back to assessments</a>
</form>

@await Component.InvokeAsync("ReasonDialog", new
{
    context = "ScoreEdit",
    formId = "scoreForm",
    selected = Model.Reason
})

@section Scripts {
<script>
    // Convenience only: the SERVER decides whether a reason is required.
    document.getElementById('saveBtn').addEventListener('click', function () {
        var form = document.getElementById('scoreForm');
        var needsReason = false;
        form.querySelectorAll('tbody tr[data-recorded="true"]').forEach(function (tr) {
            var vals = [
                tr.querySelector('select').value,
                tr.querySelector('input[type=number]').value,
                tr.querySelector('input[type=datetime-local]').value
            ].join('|');
            if (vals !== tr.getAttribute('data-orig')) needsReason = true;
        });
        if (needsReason) {
            new bootstrap.Modal(document.getElementById('reasonModal')).show();
        } else {
            form.submit();
        }
    });
</script>
}