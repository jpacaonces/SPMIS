@model Spmis.Web.Models.ClassRecord.SimilarityViewModel
@{ ViewData["Title"] = "AI-similarity check"; }

<h2>AI-similarity check</h2>
<p class="text-muted">
    @Model.Header · <strong>@Model.AssessmentTitle</strong> ·
    @Model.StudentNo @Model.StudentName · score status: @Model.ScoreStatus
</p>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<p class="small text-muted">
    0–@Model.AcceptedMax.ToString("0.##")% Accepted ·
    up to @Model.RevisionMax.ToString("0.##")% Accepted with revision ·
    above that Not accepted. A check never changes the grade by itself; mark the item
    Violation in the score grid if that is the decision.
</p>

@if (Model.CanCheck)
{
    <form asp-action="Similarity" method="post" class="mb-4">
        <input type="hidden" asp-for="AssessmentId" />
        <input type="hidden" asp-for="EnrollmentId" />
        <div class="mb-3">
            <label asp-for="Percent" class="form-label"></label>
            <input asp-for="Percent" class="form-control" type="number" step="0.01" min="0" max="100" />
            <span asp-validation-for="Percent" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Note" class="form-label"></label>
            <textarea asp-for="Note" class="form-control" rows="2" maxlength="500"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Record check</button>
    </form>
}
else
{
    <div class="alert alert-warning">A check can only be recorded for a Submitted score.</div>
}

<h5>History</h5>
@if (!Model.History.Any())
{
    <p>No checks recorded yet.</p>
}
else
{
    <table class="table table-sm">
        <thead><tr><th>When</th><th class="text-end">%</th><th>Result</th><th>By</th><th>Note</th></tr></thead>
        <tbody>
        @foreach (var h in Model.History)
        {
            <tr>
                <td>@h.CheckedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="text-end">@h.Percent.ToString("0.##")</td>
                <td>@h.Band</td>
                <td>@h.CheckedBy</td>
                <td>@h.Note</td>
            </tr>
        }
        </tbody>
    </table>
}

<a class="btn btn-outline-secondary" asp-action="Entry" asp-route-id="@Model.AssessmentId">Back to scores</a>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }