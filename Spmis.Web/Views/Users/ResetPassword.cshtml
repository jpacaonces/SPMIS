@model Spmis.Web.Models.Admin.UserPasswordResetViewModel
@{
    ViewData["Title"] = "Reset password";
}

<h1 class="h3 mb-3">Reset password</h1>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.FullName</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
</dl>

<div class="alert alert-warning">
    The person will be signed out everywhere and must use the new password. Give it to them in person, never by chat or email.
</div>

<form id="resetForm" asp-action="ResetPassword" method="post" class="col-lg-5">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <input type="hidden" asp-for="UserId" />

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <p class="form-text">At least 8 characters with an uppercase letter, a lowercase letter and a digit.</p>

    <button type="button" id="openReason" class="btn btn-danger">Reset password</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@await Component.InvokeAsync("ReasonDialog", new
{
    context = "PasswordReset",
    formId = "resetForm",
    selected = Model.Reason
})

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('openReason').addEventListener('click', function () {
            var form = document.getElementById('resetForm');
            if (window.jQuery && jQuery(form).valid && !jQuery(form).valid()) {
                return;
            }
            bootstrap.Modal.getOrCreateInstance(document.getElementById('reasonModal')).show();
        });
    </script>
}