@if (User.Identity?.IsAuthenticated == true)
{
    @* Navigation lives on the Home tiles page. This spacer keeps the
       user name and Sign out pushed to the right of the bar. *@
    <div class="flex-grow-1"></div>

    <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center">
        <span class="navbar-text me-3">@User.Identity.Name</span>
        <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
    </form>
}