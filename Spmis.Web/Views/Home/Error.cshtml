@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h3 text-danger">Something went wrong</h1>
<p>The request could not be completed. If you were saving something, check it before trying again.</p>

@if (Model.ShowRequestId)
{
    <p class="text-muted">Reference: <code>@Model.RequestId</code>. Give this to your administrator.</p>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to home</a>