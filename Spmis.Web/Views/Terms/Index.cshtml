@model List<Spmis.Web.Models.Admin.TermListItem>
@{ ViewData["Title"] = "Academic terms"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">New term</a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<table class="table table-sm align-middle">
    <thead>
        <tr><th>School year</th><th>Sem</th><th>Start</th><th>End</th>
            <th>Classes</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.SchoolYear</td>
            <td>@t.Semester</td>
            <td>@t.StartDate.ToString("yyyy-MM-dd")</td>
            <td>@t.EndDate.ToString("yyyy-MM-dd")</td>
            <td>@t.ClassCount</td>
            <td>@if (t.IsCurrent) { <span class="badge bg-success">Current</span> }</td>
            <td>
                @if (!t.IsCurrent)
                {
                    <a asp-action="SetCurrent" asp-route-id="@t.Id"
                       class="btn btn-sm btn-outline-primary">Set as current</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>